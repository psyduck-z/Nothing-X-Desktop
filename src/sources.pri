    $$PWD/modelconfig.h \
    $$PWD/officialimageprovider.h \
    $$PWD/officialpack.h \
    $$PWD/popupplacer.h \
    $$PWD/protocol.h \
    $$PWD/settings.h \
    $$PWD/theme.h \
    $$PWD/transport.h \
    $$PWD/trayicon.h \
    $$PWD/updater.h

SOURCES += \
    $$PWD/app.cpp \
    $$PWD/autostart.cpp \
    $$PWD/bttransport.cpp \
    $$PWD/demotransport.cpp \
    $$PWD/device.cpp \
    $$PWD/devicescanner.cpp \
    $$PWD/iconprovider.cpp \
    $$PWD/modelconfig.cpp \
    $$PWD/officialimageprovider.cpp \
    $$PWD/officialpack.cpp \
    $$PWD/popupplacer.cpp \
